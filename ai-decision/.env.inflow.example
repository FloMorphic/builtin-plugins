# PLUGIN_ID is the plugin's registered identity (it must match the `pluginId` of
# the backing extension row), not a label — it kept its original value when the
# node was renamed from `jev` to `ai-decision`, so no redeploy or row migration
# was needed.
PLUGIN_ID=aaaa-bbbb-cccc-jev0
INFRA_URL=nats://your-infra-host:4222
INFRA_CRED=base64-encoded-credentials
